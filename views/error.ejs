<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <!-- Error Card -->
      <div class="card border-0 shadow-lg rounded-4 text-center p-5">
        <!-- Error Icon -->
        <div class="mb-4">
          <i class="fa-solid fa-triangle-exclamation fa-4x text-danger"> </i>
        </div>

        <!-- Error Status -->
        <h1 class="fw-bold display-5">Oops!</h1>

        <!-- Error Message -->
        <h4 class="text-muted mt-3"><%= err.statusCode || 500 %></h4>

        <!-- Error Description -->
        <p class="mt-3 text-muted">
          <%= err.message || "Something went wrong!" %>
        </p>

        <!-- Redirect Button -->
        <div class="mt-4">
          <a href="/listings" class="btn btn-dark px-4 py-2">
            Back To Explore
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
