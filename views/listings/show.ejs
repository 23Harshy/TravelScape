<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <!-- Destination Title -->
    <div class="mb-4 text-center">

        <h1 class="fw-bold display-5">
            <%= listing.title %>
        </h1>

        <p class="text-muted fs-5">
            Explore breathtaking landscapes,
            adventure trails, and unforgettable travel experiences.
        </p>

    </div>





    <!-- Destination Image -->
    <div class="card border-0 shadow-sm mb-4">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top rounded"
            style="height: 500px; object-fit: cover;"
            alt="destination image">

    </div>






    <!-- Destination Details -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <!-- Description -->
            <h3 class="mb-3">
                About This Destination
            </h3>

            <p class="text-muted">
                <%= listing.description %>
            </p>





            <hr class="my-4">






            <!-- Information Grid -->
            <div class="row">

                <!-- State -->
                <div class="col-md-6 mb-4">

                    <h5>📍 State</h5>

                    <p>
                        <%= listing.state %>
                    </p>

                </div>





                <!-- Region -->
                <div class="col-md-6 mb-4">

                    <h5>🗺 Region</h5>

                    <p>
                        <%= listing.region %>
                    </p>

                </div>





                <!-- Category -->
                <div class="col-md-6 mb-4">

                    <h5>🏕 Category</h5>

                    <span class="badge bg-dark p-2">
                        <%= listing.category %>
                    </span>

                </div>





                <!-- Trek Difficulty -->
                <div class="col-md-6 mb-4">

                    <h5>🥾 Trek Difficulty</h5>

                    <span class="badge bg-secondary p-2">
                        <%= listing.trekDifficulty %>
                    </span>

                </div>





                <!-- Best Season -->
                <div class="col-md-6 mb-4">

                    <h5>🌤 Best Time To Visit</h5>

                    <p>
                        <%= listing.bestSeason %>
                    </p>

                </div>





                <!-- Estimated Budget -->
                <div class="col-md-6 mb-4">

                    <h5>💰 Estimated Budget</h5>

                    <p>
                        ₹ <%= listing.estimatedCost %>
                    </p>

                </div>





                <!-- Altitude -->
                <div class="col-md-6 mb-4">

                    <h5>⛰ Altitude</h5>

                    <p>
                        <%= listing.altitude %>
                    </p>

                </div>

            </div>






            <hr class="my-4">






            <!-- Activities -->
            <h3 class="mb-3">
                Activities
            </h3>

            <% if(listing.activities && listing.activities.length > 0){ %>

                <% listing.activities.forEach(activity => { %>

                    <span class="badge bg-dark me-2 mb-2 p-2">
                        <%= activity %>
                    </span>

                <% }) %>

            <% } else { %>

                <p class="text-muted">
                    No activities available.
                </p>

            <% } %>







            <hr class="my-4">







            <!-- How To Reach -->
            <h3 class="mb-3">
                How To Reach
            </h3>

            <p class="text-muted">
                <%= listing.howToReach %>
            </p>







            <hr class="my-4">







            <!-- Owner -->
            <p class="text-muted">

                Added by:

                <strong>
                    <%= listing.owner ? listing.owner.username : "Unknown User" %>
                </strong>

            </p>

        </div>

    </div>







    <!-- Edit/Delete Buttons -->
    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>

        <div class="mb-5">

            <!-- Edit Button -->
            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark me-2">

                Edit Destination

            </a>





            <!-- Delete Button -->
            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="d-inline">

                <button class="btn btn-danger">

                    Delete Destination

                </button>

            </form>

        </div>

    <% } %>








    <!-- Reviews Section -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h3 class="mb-4">
                Traveler Reviews
            </h3>







            <!-- Add Review Form -->
            <% if(currUser){ %>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews"
                    class="needs-validation"
                    novalidate>





                    <!-- Rating -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Rating
                        </label>

                        <input
                            type="range"
                            min="1"
                            max="5"
                            name="review[rating]"
                            class="form-range">

                    </div>








                    <!-- Review Comment -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Share Your Experience
                        </label>

                        <textarea
                            name="review[comment]"
                            rows="3"
                            class="form-control"
                            required></textarea>

                    </div>








                    <!-- Submit Button -->
                    <button class="btn btn-dark">
                        Add Review
                    </button>

                </form>

            <% } %>








            <hr class="my-4">








            <!-- Reviews Grid -->
            <div class="row">

                <% for(review of listing.reviews){ %>

                    <div class="col-md-6 mb-4">

                        <div class="card review-card shadow-sm border-0 h-100">

                            <div class="card-body">

                                <h5 class="fw-semibold">

                                    <%= review.author ? review.author.username : "Anonymous" %>

                                </h5>





                                <p class="text-muted">

                                    <%= review.comment %>

                                </p>





                                <p>

                                    ⭐ Rating:
                                    <strong>
                                        <%= review.rating %>/5
                                    </strong>

                                </p>







                                <!-- Delete Review -->
                                <% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>

                                    <form
                                        method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                                        <button class="btn btn-sm btn-danger">

                                            Delete Review

                                        </button>

                                    </form>

                                <% } %>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>